{
  "$schema": "https://raw.githubusercontent.com/nicokosi/tauri-plugin-schema/main/capabilities-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Russh",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:webview:default",
    "core:webview:allow-internal-toggle-devtools",
    "store:default",
    "shell:allow-open"
  ]
}
